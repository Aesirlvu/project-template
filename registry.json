{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "project-template",
  "homepage": "https://github.com/Aesirlvu/project-template",
  "items": [
    {
      "name": "base-setup",
      "type": "registry:base",
      "title": "Base setup",
      "description": "Next.js + shadcn/ui base design system with theme provider, CSS variables, and the Button component. Dependencies are merged into your package.json.",
      "author": "Aesirlvu <https://github.com/Aesirlvu>",
      "extends": "none",
      "style": "base-sera",
      "iconLibrary": "tabler",
      "baseColor": "zinc",
      "theme": "zinc",
      "dependencies": [
        "@base-ui/react@^1.9.0",
        "@tabler/icons-react@^3.51.0",
        "class-variance-authority@^0.7.1",
        "cn@^0.5.2",
        "next-themes@^0.4.6",
        "shadcn@^4.23.0",
        "tailwind-compose@^1.1.1",
        "tw-animate-css@^1.4.0"
      ],
      "devDependencies": [
        "@tailwindcss/postcss@^4",
        "tailwindcss@^4"
      ],
      "files": [
        {
          "path": "app/globals.css",
          "type": "registry:style",
          "target": "~/app/globals.css"
        },
        {
          "path": "components/theme-provider.tsx",
          "type": "registry:component",
          "target": "@components/theme-provider.tsx"
        },
        {
          "path": "components/ui/button.tsx",
          "type": "registry:ui",
          "target": "@ui/button.tsx"
        },
        {
          "path": "lib/utils.ts",
          "type": "registry:lib",
          "target": "@lib/utils.ts"
        },
        {
          "path": "lib/tailwind-compose.ts",
          "type": "registry:lib",
          "target": "@lib/tailwind-compose.ts"
        },
        {
          "path": "lib/compose-raw.ts",
          "type": "registry:lib",
          "target": "@lib/compose-raw.ts"
        },
        {
          "path": "postcss.config.mjs",
          "type": "registry:file",
          "target": "~/postcss.config.mjs"
        }
      ],
      "cssVars": {
        "theme": {
          "font-heading": "var(--font-heading)",
          "font-sans": "var(--font-sans)",
          "font-mono": "var(--font-mono)"
        }
      }
    },
