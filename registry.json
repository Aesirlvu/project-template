{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "project-template",
  "homepage": "https://github.com/Aesirlvu/project-template",
  "items": [
    {
      "name": "base-setup",
      "type": "registry:base",
      "title": "Base setup",
      "description": "Next.js + shadcn/ui base design system with theme provider, CSS variables, and the Button component. Dependencies are merged into your package.json.",
      "author": "Aesirlvu <https://github.com/Aesirlvu>",
      "extends": "none",
      "style": "base-sera",
      "iconLibrary": "tabler",
      "baseColor": "zinc",
      "theme": "zinc",
      "dependencies": [
        "@base-ui/react@^1.9.0",
        "@tabler/icons-react@^3.51.0",
        "class-variance-authority@^0.7.1",
        "cn@^0.5.2",
        "next-themes@^0.4.6",
        "shadcn@^4.23.0",
        "tw-animate-css@^1.4.0"
      ],
      "devDependencies": [
        "@tailwindcss/postcss@^4",
        "tailwindcss@^4"
      ],
      "files": [
        {
          "path": "app/globals.css",
          "type": "registry:style",
          "target": "~/app/globals.css"
        },
        {
          "path": "components/theme-provider.tsx",
          "type": "registry:component",
          "target": "@components/theme-provider.tsx"
        },
        {
          "path": "components/ui/button.tsx",
          "type": "registry:ui",
          "target": "@ui/button.tsx"
        },
        {
          "path": "lib/utils.ts",
          "type": "registry:lib",
          "target": "@lib/utils.ts"
        },
        {
          "path": "postcss.config.mjs",
          "type": "registry:file",
          "target": "~/postcss.config.mjs"
        }
      ],
      "cssVars": {
        "theme": {
          "font-heading": "var(--font-heading)",
          "font-sans": "var(--font-sans)",
          "font-mono": "var(--font-mono)"
        }
      }
    },
    {
      "name": "ai-stack",
      "type": "registry:lib",
      "title": "AI stack",
      "description": "Optional AI SDK 7 integration through the Vercel AI Gateway, with a shared provider and a streaming completion helper.",
      "author": "Aesirlvu <https://github.com/Aesirlvu>",
      "dependencies": ["ai@^7.0.165", "zod@^4.6.7"],
      "devDependencies": ["@types/node@^20"],
      "envVars": {
        "AI_GATEWAY_API_KEY": "",
        "AI_DEFAULT_MODEL": "openai/gpt-5-mini"
      },
      "files": [
        {
          "path": "lib/ai/provider.ts",
          "type": "registry:lib",
          "target": "@lib/ai/provider.ts"
        },
        {
          "path": "lib/ai/completion.ts",
          "type": "registry:lib",
          "target": "@lib/ai/completion.ts"
        },
        {
          "path": "env.example",
          "type": "registry:file",
          "target": "~/env.example"
        }
      ]
    },
    {
      "name": "add-deps",
      "type": "registry:file",
      "title": "Add dependencies script",
      "description": "Script to layer your own dependencies on top of the base setup without editing package.json by hand.",
      "author": "Aesirlvu <https://github.com/Aesirlvu>",
      "files": [
        {
          "path": "scripts/add-deps.mjs",
          "type": "registry:file",
          "target": "~/scripts/add-deps.mjs"
        }
      ],
      "docs": "Run `node scripts/add-deps.mjs <package>[@version]` to add runtime dependencies, `node scripts/add-deps.mjs --dev <package>` for development dependencies, and `node scripts/add-deps.mjs --list` to inspect what is installed."
    },
    {
      "name": "docs-pack",
      "type": "registry:file",
      "title": "Docs pack",
      "description": "Architecture and conventions documentation plus agent instructions, ready to drop into a new project.",
      "author": "Aesirlvu <https://github.com/Aesirlvu>",
      "files": [
        {
          "path": "docs/architecture.md",
          "type": "registry:file",
          "target": "~/docs/architecture.md"
        },
        {
          "path": "docs/conventions.md",
          "type": "registry:file",
          "target": "~/docs/conventions.md"
        },
        {
          "path": "agent/AGENTS.md",
          "type": "registry:file",
          "target": "~/AGENTS.md"
        },
        {
          "path": "agent/ARCHITECTURE.md",
          "type": "registry:file",
          "target": "~/docs/ARCHITECTURE.md"
        }
      ],
      "docs": "Installs `docs/architecture.md`, `docs/conventions.md`, `docs/ARCHITECTURE.md` and `AGENTS.md` in the consumer project."
    },
    {
      "name": "app-shell",
      "type": "registry:block",
      "title": "App shell",
      "description": "Desktop application shell with sidebar navigation, topbar, and reusable nav primitives.",
      "author": "Aesirlvu <https://github.com/Aesirlvu>",
      "registryDependencies": ["Aesirlvu/project-template/base-setup"],
      "files": [
        {
          "path": "components/shell/types.ts",
          "type": "registry:lib",
          "target": "@components/shell/types.ts"
        },
        {
          "path": "components/shell/nav-link.tsx",
          "type": "registry:component",
          "target": "@components/shell/nav-link.tsx"
        },
        {
          "path": "components/shell/sidebar-nav.tsx",
          "type": "registry:component",
          "target": "@components/shell/sidebar-nav.tsx"
        },
        {
          "path": "components/shell/app-sidebar.tsx",
          "type": "registry:component",
          "target": "@components/shell/app-sidebar.tsx"
        },
        {
          "path": "components/shell/app-topbar.tsx",
          "type": "registry:component",
          "target": "@components/shell/app-topbar.tsx"
        },
        {
          "path": "components/shell/app-shell.tsx",
          "type": "registry:component",
          "target": "@components/shell/app-shell.tsx"
        }
      ],
      "docs": "Requires `base-setup`. Import `AppShell` from `@/components/shell/app-shell` and pass a `NavSection[]` describing your navigation."
    },
    {
      "name": "mobile-shell",
      "type": "registry:block",
      "title": "Mobile shell",
      "description": "Mobile-first application shell with a drawer menu and bottom tab bar, including safe-area handling.",
      "author": "Aesirlvu <https://github.com/Aesirlvu>",
      "registryDependencies": ["Aesirlvu/project-template/base-setup"],
      "files": [
        {
          "path": "components/shell/types.ts",
          "type": "registry:lib",
          "target": "@components/shell/types.ts"
        },
        {
          "path": "components/shell/nav-link.tsx",
          "type": "registry:component",
          "target": "@components/shell/nav-link.tsx"
        },
        {
          "path": "components/shell/sidebar-nav.tsx",
          "type": "registry:component",
          "target": "@components/shell/sidebar-nav.tsx"
        },
        {
          "path": "components/shell/mobile-nav.tsx",
          "type": "registry:component",
          "target": "@components/shell/mobile-nav.tsx"
        },
        {
          "path": "components/shell/mobile-tab-bar.tsx",
          "type": "registry:component",
          "target": "@components/shell/mobile-tab-bar.tsx"
        },
        {
          "path": "components/shell/mobile-shell.tsx",
          "type": "registry:component",
          "target": "@components/shell/mobile-shell.tsx"
        }
      ],
      "docs": "Requires `base-setup`. Import `MobileShell` from `@/components/shell/mobile-shell` and `MobileTabBar` from `@/components/shell/mobile-tab-bar`."
    },
    {
      "name": "dashboard-layout",
      "type": "registry:page",
      "title": "Dashboard layout",
      "description": "Route-group layout with the viewport configuration required for edge-to-edge mobile rendering.",
      "author": "Aesirlvu <https://github.com/Aesirlvu>",
      "files": [
        {
          "path": "app/(app)/layout.tsx",
          "type": "registry:page",
          "target": "~/app/(app)/layout.tsx"
        }
      ],
      "docs": "Creates `app/(app)/layout.tsx` in the consumer. Add your own pages under `app/(app)/`."
    },
    {
      "name": "agent-skills",
      "type": "registry:item",
      "title": "Agent skills",
      "description": "Agent-facing skill packs covering shadcn registry authoring and Next.js application shell construction.",
      "author": "Aesirlvu <https://github.com/Aesirlvu>",
      "files": [
        {
          "path": "skills/shadcn-registry-authoring/SKILL.md",
          "type": "registry:file",
          "target": "~/skills/shadcn-registry-authoring/SKILL.md"
        },
        {
          "path": "skills/nextjs-app-shell/SKILL.md",
          "type": "registry:file",
          "target": "~/skills/nextjs-app-shell/SKILL.md"
        }
      ],
      "docs": "Installs skill packs under `skills/`. Point your agent at the installed `SKILL.md` files to pick up the conventions used by this template."
    }
  ]
}
